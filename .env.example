# Step 2 uses the mock model; no hosted AI credentials are needed.
# Compose sets these values explicitly; .env is not loaded by the Python app yet.
MODEL_ADAPTER=mock
# Compose publishes the app here (default CLI URL assumes 8002).
APP_PORT=8002
# Swagger, ReDoc and OpenAPI schema are disabled unless this is exactly 1.
ENABLE_API_DOCS=0
